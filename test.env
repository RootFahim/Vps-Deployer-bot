#
#                    RFRS LXC BOT 1.0 PRO
#
# ============================================================================


# ----------------------------------------------------------------------------
#  1) DISCORD  (required)
# ----------------------------------------------------------------------------

# Your bot token (Discord Developer Portal -> Bot -> Reset Token). Keep it secret!
DISCORD_TOKEN=ENTER YOUR TOKEN HERE

# Discord user IDs of the admins, comma separated (no spaces).
# Enable Developer Mode in Discord, right click a user -> Copy User ID.
ADMIN_IDS=1473315482554732786

# Command prefix. Example: ! -> !help  !deploy  !manage
PREFIX=!


# ----------------------------------------------------------------------------
#  2) BRANDING
# ----------------------------------------------------------------------------

# Bot name shown in embeds, footers, the WebSSH page and the bot status.
BOT_NAME=RFRS LXC BOT v1.0 PRO

# Embed side-bar color, HEX without "#".  (7C3AED = purple)
EMBED_COLOR=7C3AED


# ----------------------------------------------------------------------------
#  3) VPS PLAN  (applied to every !deploy)
# ----------------------------------------------------------------------------

# RAM in GB
DEFAULT_RAM_GB=1

# CPU cores
DEFAULT_CPU=1

# Disk size in GB  (needs a ZFS / btrfs / LVM storage pool for hard limits)
DEFAULT_DISK_GB=10

# How many VPS one user can create. Admins are unlimited.
MAX_VPS_PER_USER=1


# ----------------------------------------------------------------------------
#  4) OPERATING SYSTEMS
# ----------------------------------------------------------------------------

# Format:   Label|image|family   - entries separated by commas, keep it on ONE line
#   image  : "remote:alias" or just an alias (uses the "images:" remote).
#            Use ";" to add fallback images (the first one that works is used).
#   family : apt (Ubuntu/Debian)  |  apk (Alpine)  |  dnf (AlmaLinux/Rocky/Fedora)
OS_LIST=Ubuntu 24.04|ubuntu:24.04;images:ubuntu/24.04|apt,Ubuntu 22.04|ubuntu:22.04;images:ubuntu/22.04|apt,Ubuntu 20.04|ubuntu:20.04;images:ubuntu/20.04|apt,Debian 13|debian/13;debian/trixie|apt,Debian 12|debian/12;debian/bookworm|apt,Debian 11|debian/11;debian/bullseye|apt,Alpine 3.20|alpine/3.20|apk,AlmaLinux 9|almalinux/9|dnf


# ----------------------------------------------------------------------------
#  5) WEBSSH  (runs inside the bot)
# ----------------------------------------------------------------------------

# Address the WebSSH server listens on. 0.0.0.0 = all interfaces.
WEB_HOST=0.0.0.0

# Port of the WebSSH server (open it in your firewall).
WEB_PORT=8080

# PUBLIC link used in the WebSSH button - must start with http:// or https://
# Example: http://123.45.67.89:8080   or   https://ssh.yourdomain.com
WEBSSH_URL=http://YOUR_SERVER_IP:8080


# ----------------------------------------------------------------------------
#  6) PANEL (!manage)
# ----------------------------------------------------------------------------

# true  = the panel updates itself automatically
# false = it only updates when someone presses the Refresh button
LIVE_REFRESH=false

# Auto-refresh interval in seconds (minimum 5). Used only when LIVE_REFRESH=true.
LIVE_REFRESH_SEC=10


# ----------------------------------------------------------------------------
#  7) STORAGE
# ----------------------------------------------------------------------------

# File where the bot saves its VPS list.
DB_FILE=db.json


# ============================================================================
#   RFRS LXC BOT 1.0 PRO   |   .env
# ============================================================================
